#!/bin/sh
# Archive and upload a private macOS TestFlight build.
set -eu
cd "$(dirname "$0")/.."

build_number=${INTERLINKED_BUILD_NUMBER:-1}
relay_url=${INTERLINKED_JEV_RELAY_URL:-https://interlinked-jev.187-77-224-188.sslip.io/v1/jev}
app_store_id=${INTERLINKED_ASC_APP_ID:-6814002217}
external_group_id=${INTERLINKED_TESTFLIGHT_GROUP_ID:-e1987dcb-534c-4918-b460-eaeb3d8277d4}
archive="$PWD/.build/testflight/Interlinked.xcarchive"
export_path="$PWD/.build/testflight/export"

case "$relay_url" in
  https://*) ;;
  *) echo "Set INTERLINKED_JEV_RELAY_URL to the HTTPS /v1/jev relay before making a TestFlight build." >&2; exit 64 ;;
esac

xcodegen generate

xcodebuild \
  -project Interlinked.xcodeproj \
  -scheme Interlinked \
  -configuration TestFlight \
  -destination 'generic/platform=macOS' \
  -archivePath "$archive" \
  -allowProvisioningUpdates \
  CURRENT_PROJECT_VERSION="$build_number" \
  INTERLINKED_JEV_RELAY_URL="$relay_url" \
  archive

app="$archive/Products/Applications/Interlinked.app"
codesign -d --entitlements :- "$app" 2>/dev/null | \
  plutil -extract 'com\.apple\.security\.app-sandbox' raw -o - - | \
  /usr/bin/grep -qx true

# Issue #14: iCloud Keychain passkeys for arbitrary sites stay unavailable
# until Apple approves the managed browser entitlement and the archive is
# signed with it. Bypass only for emergency releases that knowingly ship
# without passkeys: INTERLINKED_ALLOW_MISSING_PASSKEY_ENTITLEMENT=1.
if ! "$PWD/script/assert-passkey-entitlement" "$app"; then
  if [ "${INTERLINKED_ALLOW_MISSING_PASSKEY_ENTITLEMENT:-}" = "1" ]; then
    echo "warning: shipping a TestFlight build without iCloud Keychain passkeys." >&2
  else
    echo "Set INTERLINKED_ALLOW_MISSING_PASSKEY_ENTITLEMENT=1 to ship anyway," >&2
    echo "or check approval status with script/assert-passkey-entitlement." >&2
    exit 1
  fi
fi

rm -rf "$export_path"

xcodebuild \
  -exportArchive \
  -archivePath "$archive" \
  -exportPath "$export_path" \
  -exportOptionsPlist ExportOptions-TestFlight.plist \
  -allowProvisioningUpdates

pkg="$export_path/Interlinked.pkg"
version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")

if ! command -v asc >/dev/null 2>&1; then
  echo "Install and authenticate asc before uploading the TestFlight package." >&2
  exit 69
fi

asc builds upload \
  --app "$app_store_id" \
  --pkg "$pkg" \
  --version "$version" \
  --build-number "$build_number" \
  --platform MAC_OS \
  --wait \
  --poll-interval 15s \
  --output table

asc builds add-groups \
  --app "$app_store_id" \
  --build-number "$build_number" \
  --platform MAC_OS \
  --version "$version" \
  --group "$external_group_id" \
  --submit \
  --confirm
