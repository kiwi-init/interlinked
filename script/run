#!/bin/sh
# Build Interlinked.app with xcodebuild and open it.
set -e
cd "$(dirname "$0")/.."

if [ ! -f Interlinked.xcodeproj/project.pbxproj ]; then
  xcodegen generate
fi

xcodebuild \
  -project Interlinked.xcodeproj \
  -scheme Interlinked \
  -configuration Debug \
  -derivedDataPath build \
  -destination 'platform=macOS' \
  -allowProvisioningUpdates \
  build

app=build/Build/Products/Debug/Interlinked.app
bin="$PWD/$app/Contents/MacOS/Interlinked"
team=$(/usr/bin/codesign -dvv "$app" 2>&1 | /usr/bin/sed -n 's/^TeamIdentifier=//p')
test "$team" = "57249C654W"

# Quit the Interlinked you use, which shares this build's data, and force
# only this build's own binary: test and isolated copies keep running.
/usr/bin/osascript -e 'tell application id "computer.interlinked" to quit' >/dev/null 2>&1 || true
# Up to 5 s, so a quit still saving the session, history, and downloads finishes.
attempt=0
while /usr/bin/pgrep -f "$bin" >/dev/null && [ "$attempt" -lt 50 ]; do
  /bin/sleep 0.1
  attempt=$((attempt + 1))
done
/usr/bin/pkill -f "$bin" >/dev/null 2>&1 || true
open -n "$app" --args -ApplePersistenceIgnoreState YES
