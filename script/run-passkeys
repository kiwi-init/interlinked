#!/bin/sh
# Build with Apple's managed browser passkey capability and open the app.
set -eu
cd "$(dirname "$0")/.."

team=${INTERLINKED_DEVELOPMENT_TEAM:-57249C654W}

if [ ! -f Interlinked.xcodeproj/project.pbxproj ]; then
  xcodegen generate
fi

xcodebuild \
  -project Interlinked.xcodeproj \
  -target Interlinked \
  -configuration Debug \
  -destination 'platform=macOS' \
  -allowProvisioningUpdates \
  SYMROOT="$PWD/build-passkeys" \
  CODE_SIGN_STYLE=Automatic \
  CODE_SIGN_IDENTITY='Apple Development' \
  DEVELOPMENT_TEAM="$team" \
  CODE_SIGN_ENTITLEMENTS=Interlinked/InterlinkedPasskeys.entitlements \
  build

app=build-passkeys/Debug/Interlinked.app
codesign -d --entitlements - --xml "$app" 2>&1 | \
  plutil -extract com.apple.developer.web-browser.public-key-credential raw -o - - | \
  /usr/bin/grep -qx true

/usr/bin/osascript -e 'tell application id "computer.interlinked" to quit' >/dev/null 2>&1 || true
attempt=0
while /usr/bin/pgrep -x Interlinked >/dev/null && [ "$attempt" -lt 20 ]; do
  /bin/sleep 0.1
  attempt=$((attempt + 1))
done
/usr/bin/pkill -x Interlinked >/dev/null 2>&1 || true
open -n "$app"
