#!/bin/sh
# Build a Debug Interlinked that keeps to itself and open it beside the one
# you use. It has its own bundle ID, so its settings and website data are
# separate, and CFFIXED_USER_HOME puts its session, history, caches and
# downloads list under DATA instead of ~/Library/Application Support.
#
#   script/run-isolated [--fresh] [DATA]
#
# DATA defaults to $TMPDIR/interlinked-isolated. --fresh deletes DATA and the
# copy's settings first. Each DATA gets its own control socket, printed at the
# end. Copies that run at the same time should use different DATA and, to keep
# settings and website data apart too, different INTERLINKED_BUNDLE_ID_SUFFIX
# values (default .isolated).
set -eu
cd "$(dirname "$0")/.."

suffix=${INTERLINKED_BUNDLE_ID_SUFFIX:-.isolated}
bundle=computer.interlinked$suffix
products=build-isolated
if [ "$suffix" != ".isolated" ]; then
  products=build-isolated-$(printf %s "$suffix" | tr -c 'A-Za-z0-9\n' '-' | sed 's/^-*//')
fi
fresh=0
if [ "${1:-}" = "--fresh" ]; then
  fresh=1
  shift
fi
tmp=${TMPDIR:-/tmp}
data=${1:-${tmp%/}/interlinked-isolated}
mkdir -p "$data"
data=$(cd "$data" && pwd -P)

# A control socket path must fit in 104 bytes, which DATA usually does not,
# so sockets live in a short private directory, one per DATA.
sockets=/tmp/interlinked-isolated-$(id -u)
mkdir -p -m 700 "$sockets"
if [ -L "$sockets" ] || [ ! -O "$sockets" ]; then
  echo "run-isolated: $sockets is not a directory you own" >&2
  exit 1
fi
chmod 700 "$sockets"
socket=$sockets/$(printf %s "$data" | shasum | cut -c1-12).sock

if [ ! -f Interlinked.xcodeproj/project.pbxproj ]; then
  xcodegen generate
fi

# Ad-hoc signed, like CI, so the new bundle ID needs nothing from the team's
# developer account.
xcodebuild \
  -project Interlinked.xcodeproj \
  -scheme Interlinked \
  -configuration Debug \
  -derivedDataPath "$products" \
  -destination 'platform=macOS' \
  INTERLINKED_BUNDLE_ID_SUFFIX="$suffix" \
  CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES DEVELOPMENT_TEAM= \
  build

app=$PWD/$products/Build/Products/Debug/Interlinked.app
binary=$app/Contents/MacOS/Interlinked
control=$PWD/$products/Build/Products/Debug/interlinked

# Quit the copy using this DATA through its own socket, then any copy of this
# build. Nothing here can reach the Interlinked you use or another worktree's
# copy.
if [ -S "$socket" ]; then
  INTERLINKED_SOCKET=$socket "$control" quit >/dev/null 2>&1 || true
fi
attempt=0
while /usr/bin/pgrep -qf "$binary" && [ "$attempt" -lt 50 ]; do
  [ "$attempt" -eq 20 ] && /usr/bin/pkill -TERM -f "$binary" >/dev/null 2>&1
  /bin/sleep 0.1
  attempt=$((attempt + 1))
done
/usr/bin/pkill -KILL -f "$binary" >/dev/null 2>&1 || true

if [ "$fresh" -eq 1 ]; then
  rm -rf "$data"
  mkdir -p "$data"
  /usr/bin/defaults delete "$bundle" >/dev/null 2>&1 || true
fi

# -g keeps focus on whatever you're doing, often the Interlinked you use.
open -n -g "$app" \
  --env CFFIXED_USER_HOME="$data" \
  --env INTERLINKED_SOCKET="$socket" \
  --args -ApplePersistenceIgnoreState YES

echo "Isolated Interlinked ($bundle)"
echo "  data:    $data"
echo "  socket:  $socket"
echo "  control: INTERLINKED_SOCKET=$socket $control state"
