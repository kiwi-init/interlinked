#!/bin/sh
# Build a Debug Interlinked that keeps to itself and open it beside the one
# you use. It has its own bundle ID, so its settings and website data are
# separate, and CFFIXED_USER_HOME puts its session, history, caches and
# downloads list under DATA instead of ~/Library/Application Support.
#
#   script/run-isolated [--fresh] [DATA]
#
# DATA defaults to $TMPDIR/interlinked-isolated. --fresh deletes DATA and the
# isolated build's settings first. Drive it with:
#   INTERLINKED_SOCKET=/tmp/interlinked-isolated-$(id -u)/control.sock \
#     build-isolated/Build/Products/Debug/interlinked state
set -eu
cd "$(dirname "$0")/.."

bundle=computer.interlinked.isolated
fresh=0
if [ "${1:-}" = "--fresh" ]; then
  fresh=1
  shift
fi
tmp=${TMPDIR:-/tmp}
data=${1:-${tmp%/}/interlinked-isolated}

if [ ! -f Interlinked.xcodeproj/project.pbxproj ]; then
  xcodegen generate
fi

# Ad-hoc signed, like CI, so the new bundle ID needs nothing from the team's
# developer account.
xcodebuild \
  -project Interlinked.xcodeproj \
  -scheme Interlinked \
  -configuration Debug \
  -derivedDataPath build-isolated \
  -destination 'platform=macOS' \
  INTERLINKED_BUNDLE_ID_SUFFIX=.isolated \
  CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES DEVELOPMENT_TEAM= \
  build

app=$PWD/build-isolated/Build/Products/Debug/Interlinked.app

# Only the isolated copy is ever quit here, never the Interlinked you use.
if /usr/bin/pgrep -qf "$app/Contents/MacOS/Interlinked"; then
  /usr/bin/osascript -e "tell application id \"$bundle\" to quit" >/dev/null 2>&1 || true
  attempt=0
  while /usr/bin/pgrep -qf "$app/Contents/MacOS/Interlinked" && [ "$attempt" -lt 50 ]; do
    /bin/sleep 0.1
    attempt=$((attempt + 1))
  done
  /usr/bin/pkill -f "$app/Contents/MacOS/Interlinked" >/dev/null 2>&1 || true
fi

if [ "$fresh" -eq 1 ]; then
  rm -rf "$data"
  /usr/bin/defaults delete "$bundle" >/dev/null 2>&1 || true
fi
mkdir -p "$data"

# A control socket path must fit in 104 bytes, which DATA usually does not,
# so the socket gets a short private directory of its own.
sockets=/tmp/interlinked-isolated-$(id -u)
mkdir -p -m 700 "$sockets"
if [ -L "$sockets" ] || [ ! -O "$sockets" ]; then
  echo "run-isolated: $sockets is not a directory you own" >&2
  exit 1
fi
chmod 700 "$sockets"
socket=$sockets/control.sock

# -g keeps focus on whatever you're doing, often the Interlinked you use.
open -n -g "$app" \
  --env CFFIXED_USER_HOME="$data" \
  --env INTERLINKED_SOCKET="$socket" \
  --args -ApplePersistenceIgnoreState YES

echo "Isolated Interlinked ($bundle)"
echo "  data:   $data"
echo "  socket: $socket"
