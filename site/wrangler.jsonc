{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Worker that only serves the static files in public/, at interlinked.kiwiinit.com.
  "name": "interlinked-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "interlinked.kiwiinit.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": false }
}
